# Copy this file to .env and fill in values as needed.
# .env is gitignored; never commit real keys.

# Cloud backend API keys (optional; only needed if using Claude or GPT-4o)

# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# Ollama runs locally; no key needed.
# Verify it's running with: curl http://localhost:11434/api/tags

# DeepEval timeout in seconds (default is low; increase for slow local models)
# Reasoning models like Qwen3 or DeepSeek R1 often need 300-900 seconds

DEEPEVAL_TIMEOUT=900
